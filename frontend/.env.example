# Local development — Next.js loads `.env.local` (copy this file).
#   copy .env.example .env.local

# Browser API base. In local/dev, keep `/api` so Next.js rewrites proxy to the backend.
# Production (e.g. Vercel): set to your public backend origin with NO trailing slash
# and NO `/api` suffix, e.g. https://your-api.up.railway.app
NEXT_PUBLIC_API_URL=/api

# Server-side rewrite target for `/api/:path*` → backend (see next.config.ts).
# Defaults to http://localhost:3001 when unset in development.
API_ORIGIN=http://localhost:3001
